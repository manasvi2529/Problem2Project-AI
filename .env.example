# =============================================================================
# ProblemPilot AI (Problem2Project AI) — Environment Configuration
# Copy this file to .env and configure your integration credentials
# =============================================================================

# Application Settings
APP_NAME=ProblemPilot AI
APP_ENV=development
DEBUG=true
HOST=127.0.0.1
PORT=8000

# Security (JWT & Core Hashing) — Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_SECRET_KEY
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (Async SQLite by default)
DATABASE_URL=sqlite+aiosqlite:///./data/problem2project.db

# -----------------------------------------------------------------------------
# GitHub OAuth 2.0 Integration
# Obtain from: https://github.com/settings/developers -> OAuth Apps -> New OAuth App
# Set Authorization callback URL to your exact backend redirect URI
# -----------------------------------------------------------------------------
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_REDIRECT_URI=http://localhost:8000/api/integrations/github/callback

# Tamper-proof OAuth State HMAC Secret (Optional, falls back to SECRET_KEY)
GITHUB_OAUTH_STATE_SECRET=optional_random_32_byte_secret_for_csrf_state

# Credential Encryption Key for Tokens at Rest (AES-256 / Fernet)
# Optional: falls back to SECRET_KEY derived key
GITHUB_TOKEN_ENCRYPTION_KEY=optional_token_encryption_key_here

# -----------------------------------------------------------------------------
# Vercel Cloud Hosting Provider
# Obtain token from: https://vercel.com/account/tokens
# -----------------------------------------------------------------------------
VERCEL_TOKEN=your_vercel_access_token_here
# Optional Vercel Team ID or Project ID
# VERCEL_TEAM_ID=team_xxxxxxxxxxxx
# VERCEL_PROJECT_ID=prj_xxxxxxxxxxxx

# -----------------------------------------------------------------------------
# Render Cloud Hosting Provider (Optional)
# Obtain API key from: https://dashboard.render.com/u/settings#api-keys
# -----------------------------------------------------------------------------
# RENDER_API_KEY=rnd_xxxxxxxxxxxx
# RENDER_SERVICE_ID=srv_xxxxxxxxxxxx

# -----------------------------------------------------------------------------
# AI Provider (choose one: openrouter, google, anthropic)
# -----------------------------------------------------------------------------
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
# GOOGLE_API_KEY=your-google-api-key-here
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# -----------------------------------------------------------------------------
# Live Web Search Provider (choose one: google_custom, serper, brave)
# -----------------------------------------------------------------------------
SEARCH_PROVIDER=google_custom
SEARCH_API_KEY=your-search-api-key-here
SEARCH_ENGINE_ID=your-google-cse-id-here

# -----------------------------------------------------------------------------
# Isolated Execution Sandbox Configuration
# -----------------------------------------------------------------------------
EXECUTION_TIMEOUT_SECONDS=30
EXECUTION_MAX_RETRIES=3
MAX_MEMORY_MB=512
