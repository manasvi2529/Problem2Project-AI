# =============================================================================
# Problem2Project AI — Environment Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# Application
APP_NAME=Problem2Project AI
APP_ENV=development
DEBUG=true
HOST=127.0.0.1
PORT=8000

# Security — CHANGE THIS! Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_SECRET_KEY

# Database (SQLite by default)
DATABASE_URL=sqlite+aiosqlite:///./data/problem2project.db

# AI Provider — choose one: google, anthropic
AI_PROVIDER=google
GOOGLE_API_KEY=your-google-api-key-here
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Web Search — choose one: google_custom, serper, brave
SEARCH_PROVIDER=google_custom
SEARCH_API_KEY=your-search-api-key-here
SEARCH_ENGINE_ID=your-google-cse-id-here

# GitHub OAuth (optional)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT_URI=http://localhost:8000/api/integrations/github/callback

# Execution Sandbox
EXECUTION_TIMEOUT_SECONDS=30
EXECUTION_MAX_RETRIES=3
